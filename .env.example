# Canonical site URL (metadata, redirects). Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Optional: Supabase (footer signups, auth). Project URL from Dashboard → Settings → API.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable/anon key (client-safe): Dashboard → API → anon or publishable default key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Or (Supabase newer naming): NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Auth: add redirect URL in Dashboard → Authentication → URL configuration:
#   http://localhost:3000/auth/callback
#   https://your-domain.com/auth/callback
#
# GitHub sign-in (auth panel): enable Authentication → Providers → GitHub in Supabase.
# Use a GitHub *OAuth App* (Settings → Developer settings → OAuth apps): Client ID + client
# secret go in Supabase; set the OAuth app “Authorization callback URL” to Supabase’s
# callback (Dashboard shows it, typically https://<project-ref>.supabase.co/auth/v1/callback).
# This path differs from GitHub *Apps* user access tokens
# (https://docs.github.com/en/apps/creating-github-apps/writing-code-for-a-github-app/building-a-login-with-github-button-with-a-github-app),
# which is for calling the GitHub API on behalf of a user, not for Supabase-hosted identity.
# Server-only; never expose in client bundles or public repos.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: Solana wallet on /sign-in and /sign-up (WalletConnect + Phantom).
# Create a project at https://cloud.reown.com/ (WalletConnect v2 / Reown).
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional RPC for wallet adapter ConnectionProvider (defaults to public mainnet-beta).
# NEXT_PUBLIC_SOLANA_RPC_URL=

# Optional: ReactBits Pro blocks (e.g. auth-3). Without this, `shadcn add @reactbits-pro/...` may fail.
# REACTBITS_LICENSE_KEY=

# Footer “Releases & benchmark notes” form → Resend (https://resend.com)
RESEND_API_KEY=
# Verified sender (domain must be verified in Resend), e.g. "ARES <notify@yourdomain.com>"
RESEND_FROM=
# Inbox that receives signup notifications (can match RESEND_FROM)
RESEND_NOTIFY_TO=

# x402 lifetime license — PayAI facilitator (https://facilitator.payai.network)
# Echo / test payments: https://x402.payai.network/ (e.g. /api/solana/paid-content)
# Payout addresses — set at least one for /license/pay (EVM 0x… and/or Solana base58)
EVM_ADDRESS=
SVM_ADDRESS=
# Optional: pay.sh gateway URL for the same commercial seat (metered HTTPS endpoint from
# `pay server start` / provider catalog). Exposes a second “Pay via pay.sh” CTA on pricing.
# NEXT_PUBLIC_PAY_SH_GATEWAY_URL=
# Optional: override facilitator base URL (default https://facilitator.payai.network)
# FACILITATOR_URL=
# Use Base Sepolia + Solana devnet when true; omit or false for Base + Solana mainnet
X402_TESTNET=
# Optional: merchant API keys (https://merchant.payai.network/) — names must match @payai/facilitator
PAYAI_API_KEY_ID=
PAYAI_API_KEY_SECRET=
